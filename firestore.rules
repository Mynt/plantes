rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null && request.auth.token.teacher == true;
    }

    function isPlausibleComplete(listId) {
      return request.resource.data.plants.size() >= get(/databases/$(database)/documents/plantLists/$(listId)).data.plants.size();
    }

    // Nota: el campo `assessment` a nivel de planta (dentro de `plants[]`) no se
    // valida aquí — esta versión de las reglas de Firestore no permite iterar
    // genéricamente sobre arrays de longitud desconocida. Un alumno podría, en
    // teoría, crear su entrega con un `plants[].assessment` ya relleno, pero
    // eso ya no es un vector XSS (el panel escapa todo al mostrarlo) y
    // cualquier corrección real del profesorado lo sobrescribe: se acepta como
    // residual cosmético documentado, no un descuido.
    match /submissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.assessment == {'grade': null, 'teacherComment': '', 'updatedAt': null}
        && (
          (
            'listId' in request.resource.data
            && request.resource.data.listId != null
            && submissionId == request.resource.data.listId + '_' + request.auth.uid
            && (
              request.resource.data.complete != true
              || isPlausibleComplete(request.resource.data.listId)
            )
          )
          ||
          (
            (!('listId' in request.resource.data) || request.resource.data.listId == null)
            && submissionId.split('_')[0] == request.auth.uid
          )
        );
      allow read, update, delete: if isTeacher();
    }

    match /plantLists/{listId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /plantListPhotos/{listId} {
      allow read: if isTeacher()
        || (
          request.auth != null
          && get(/databases/$(database)/documents/plantLists/$(listId)).data.published == true
          && exists(/databases/$(database)/documents/submissions/$(listId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/submissions/$(listId + '_' + request.auth.uid)).data.complete == true
        );
      allow write: if isTeacher();
    }
  }
}
